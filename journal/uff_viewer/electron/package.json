{
  "name": "perfect-dark-map-editor",
  "productName": "Perfect Dark Map Editor",
  "version": "1.0.0",
  "description": "Electron shell for the Perfect Dark uff map editor",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dir",
    "build:dir": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.perfectdark.jonaeru.map-editor.electron",
    "productName": "Perfect Dark Map Editor",
    "directories": {
      "output": "../../../scripts/release/electron-dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "repo-config.json"
    ],
    "extraResources": [
      {
        "from": "editor-bundle",
        "to": "editor",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
